{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SecureMate AI",
  "version": "1.0.0",
  "identifier": "com.securemate.ai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SECUREMATE AI — Desktop Security Assistant",
        "width": 1150,
        "height": 780,
        "minWidth": 900,
        "minHeight": 650,
        "decorations": true,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' asset: http: https: data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Security"
  }
}
